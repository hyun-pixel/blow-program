{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@blow/automation-core": [
        "packages/automation-core/src/index.ts"
      ],
      "@blow/naver-adapter": [
        "packages/naver-adapter/src/index.ts"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
